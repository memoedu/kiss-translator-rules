    "injectJs": "(function () {\n  if (document.documentElement.hasAttribute(\"data-memoedu-math-glyphs\")) return;\n  var ns = \"http://www.w3.org/2000/svg\";\n  var attrs = [\"d\", \"transform\", \"fill\", \"fill-rule\", \"fill-opacity\", \"stroke\", \"stroke-width\", \"stroke-linecap\", \"stroke-linejoin\", \"stroke-miterlimit\", \"stroke-opacity\", \"opacity\", \"color\", \"vector-effect\"];\n  function copy(source, target, geometry) {\n    attrs.forEach(function (name) {\n      if (name === \"d\" && !geometry) return;\n      var value = source.getAttribute(name);\n      if (value !== null && !/url\\s*\\(/i.test(value)) target.setAttribute(name, value);\n    });\n  }\n  function expand(svg) {\n    var paths = new Map();\n    svg.querySelectorAll(\"defs path[id]\").forEach(function (path) { paths.set(path.id, path); });\n    svg.querySelectorAll(\"use\").forEach(function (use) {\n      var href = use.getAttribute(\"href\") || use.getAttributeNS(\"http://www.w3.org/1999/xlink\", \"href\") || use.getAttribute(\"xlink:href\");\n      if (!href || href.charAt(0) !== \"#\") return;\n      var source = paths.get(href.slice(1));\n      var x = Number(use.getAttribute(\"x\") || 0), y = Number(use.getAttribute(\"y\") || 0);\n      if (!source || !source.hasAttribute(\"d\") || !Number.isFinite(x) || !Number.isFinite(y)) return;\n      var outer = document.createElementNS(ns, \"g\");\n      outer.setAttribute(\"data-memoedu-math-glyph\", \"1\");\n      copy(use, outer, false);\n      var position = document.createElementNS(ns, \"g\");\n      if (x || y) position.setAttribute(\"transform\", \"translate(\" + x + \" \" + y + \")\");\n      var path = document.createElementNS(ns, \"path\");\n      copy(source, path, true);\n      position.appendChild(path);\n      outer.appendChild(position);\n      use.replaceWith(outer);\n    });\n  }\n  function scan(root) {\n    if (root.nodeType !== 1 && root.nodeType !== 9) return;\n    if (root.nodeType === 1) {\n      var owner = root.closest(\".mjpage svg\");\n      if (owner) expand(owner);\n      if (root.matches(\".mjpage svg\")) expand(root);\n    }\n    root.querySelectorAll(\".mjpage svg\").forEach(expand);\n  }\n  scan(document);\n  var observer = new MutationObserver(function (records) {\n    records.forEach(function (record) {\n      if (record.type === \"attributes\") scan(record.target);\n      record.addedNodes.forEach(scan);\n    });\n  });\n  observer.observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: [\"href\", \"xlink:href\"] });\n  document.documentElement.setAttribute(\"data-memoedu-math-glyphs\", \"1\");\n})();",
